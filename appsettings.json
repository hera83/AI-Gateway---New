{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "MasterApiKey": "REPLACE_WITH_A_STRONG_RANDOM_MASTER_API_KEY"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434"
  },
  "Speaches": {
    "BaseUrl": "http://localhost:8000"
  },
  "KnowledgeBase": {
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingDimensions": 768,
    "ChunkSizeCharacters": 1000,
    "ChunkOverlapCharacters": 150,
    "MaxUploadSizeBytes": 20971520
  }
}
