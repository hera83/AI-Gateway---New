# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored; this .example file is the only one meant to be committed.

# ASP.NET Core environment name. Controls the Swagger UI environment badge colour
# (orange=Development, green=Production, gray=anything else) — see CLAUDE.md.
ASPNETCORE_ENVIRONMENT=Production

# Host port the gateway is published on. The container always listens on 8080 internally.
HOST_PORT=8080

# REQUIRED. The single administrator credential (see CLAUDE.md "Authentication & API key
# management") — there is no default because the app fails fast at startup without one.
# Generate a strong random value yourself, e.g.: openssl rand -hex 32
AUTH_MASTER_API_KEY=REPLACE_WITH_A_STRONG_RANDOM_MASTER_API_KEY

# Base URL of the Ollama instance the gateway proxies to.
# host.docker.internal resolves to the Docker host machine — change this to point at a
# different host/container if Ollama isn't running on the machine hosting this container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Base URL of the Speaches instance the gateway proxies to. Same host.docker.internal note as above.
SPEACHES_BASE_URL=http://host.docker.internal:8000
